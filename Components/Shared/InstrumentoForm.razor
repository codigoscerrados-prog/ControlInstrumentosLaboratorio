@using BlazorApp1.Components.Models

<div class="ci-card">

    <div class="ci-form-grid">

        <div>
            <label>Código</label>

            <input class="ci-input"
                   @bind="Model.Codigo" />
        </div>


        <div>
            <label>Nombre</label>

            <input class="ci-input"
                   @bind="Model.Nombre" />
        </div>


        <div>
            <label>Tipo de instrumento</label>

            <select class="ci-input"
                    @bind="Model.TipoInstrumentoId">

                <option value="0">
                    Seleccione un tipo
                </option>

                @foreach (var tipo in Tipos)
                {
                    <option value="@tipo.Id">
                        @tipo.Nombre
                    </option>
                }

            </select>

        </div>


        <div>
            <label>Grupo instrumental</label>

            <select class="ci-input"
                    @bind="Model.GrupoId">

                <option value="0">
                    Seleccione un grupo
                </option>

                @foreach (var grupo in Grupos)
                {
                    <option value="@grupo.Id">
                        @grupo.Nombre
                    </option>
                }

            </select>

        </div>


        <div>
            <label>Marca</label>

            <input class="ci-input"
                   @bind="Model.Marca" />
        </div>


        <div>
            <label>Modelo</label>

            <input class="ci-input"
                   @bind="Model.Modelo" />
        </div>


        <div>
            <label>Número de serie</label>

            <input class="ci-input"
                   @bind="Model.NumeroSerie" />
        </div>


        <div>
            <label>Rango</label>

            <input class="ci-input"
                   @bind="Model.Rango" />
        </div>


        <div>
            <label>Resolución</label>

            <input class="ci-input"
                   @bind="Model.Resolucion" />
        </div>


        <div>
            <label>Ubicación</label>

            <input class="ci-input"
                   @bind="Model.Ubicacion" />
        </div>


        <div>
            <label>Estado</label>

            <select class="ci-input"
                    @bind="Model.Estado">

                <option value="OPERATIVO">
                    Operativo
                </option>

                <option value="EN_CALIBRACION">
                    En calibración
                </option>

                <option value="EN_MANTENIMIENTO">
                    En mantenimiento
                </option>

                <option value="FUERA_SERVICIO">
                    Fuera de servicio
                </option>

                <option value="BAJA">
                    Baja
                </option>

            </select>

        </div>


        <div class="ci-form-full">

            <label>Observaciones</label>

            <textarea class="ci-input ci-textarea"
                      @bind="Model.Observaciones">
            </textarea>

        </div>

    </div>

</div>


@code {

    [Parameter, EditorRequired]
    public ActivoUi Model { get; set; } = new();


    [Parameter]
    public List<GrupoInstrumentalUi> Grupos { get; set; } = new();


    [Parameter]
    public List<TipoInstrumentoUi> Tipos { get; set; } = new();

}