@using BlazorApp1.Components.Models

<div class="ci-card">
    <div class="ci-form-grid">

        <div>
            <label>Código</label>
            <input class="ci-input"
                   @bind="Model.Codigo" />
        </div>

        <div>
            <label>Nombre</label>
            <input class="ci-input"
                   @bind="Model.Nombre" />
        </div>

        <div>
            <label>Tipo de instrumento</label>

            <select class="ci-input"
                    @bind="Model.TipoInstrumentoNombre">

                <option value="Manómetro">
                    Manómetro
                </option>

                <option value="Termómetro">
                    Termómetro
                </option>

                <option value="Caudalímetro">
                    Caudalímetro
                </option>

                <option value="Medidor volumétrico">
                    Medidor volumétrico
                </option>

                <option value="Cronómetro">
                    Cronómetro
                </option>

                <option value="Termohigrómetro">
                    Termohigrómetro
                </option>

            </select>
        </div>

        <div>
            <label>Grupo instrumental</label>

            <select class="ci-input"
                    @bind="Model.GrupoNombre">

                <option value="Banco 3">
                    Banco 3
                </option>

                <option value="Banco 4">
                    Banco 4
                </option>

                <option value="Banco 5">
                    Banco 5
                </option>

                <option value="Banco 6">
                    Banco 6
                </option>

                <option value="Respaldo">
                    Respaldo
                </option>

                <option value="Patrones">
                    Patrones
                </option>

            </select>
        </div>

        <div>
            <label>Marca</label>
            <input class="ci-input"
                   @bind="Model.Marca" />
        </div>

        <div>
            <label>Modelo</label>
            <input class="ci-input"
                   @bind="Model.Modelo" />
        </div>

        <div>
            <label>Número de serie</label>
            <input class="ci-input"
                   @bind="Model.NumeroSerie" />
        </div>

        <div>
            <label>Rango</label>
            <input class="ci-input"
                   @bind="Model.Rango" />
        </div>

        <div>
            <label>Resolución</label>
            <input class="ci-input"
                   @bind="Model.Resolucion" />
        </div>

        <div>
            <label>Ubicación</label>
            <input class="ci-input"
                   @bind="Model.Ubicacion" />
        </div>

        <div>
            <label>Estado</label>

            <select class="ci-input"
                    @bind="Model.Estado">

                <option value="OPERATIVO">
                    Operativo
                </option>

                <option value="EN_CALIBRACION">
                    En calibración
                </option>

                <option value="EN_MANTENIMIENTO">
                    En mantenimiento
                </option>

                <option value="FUERA_SERVICIO">
                    Fuera de servicio
                </option>

                <option value="BAJA">
                    Baja
                </option>

            </select>
        </div>

        <div class="ci-form-full">
            <label>Observaciones</label>

            <textarea class="ci-input ci-textarea"
                      @bind="Model.Observaciones">
            </textarea>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ActivoUi Model { get; set; } = new();
}