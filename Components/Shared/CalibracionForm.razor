@using BlazorApp1.Components.Models

<div class="ci-card">

    <div class="ci-form-grid">

        <div>

            <label>
                Instrumento
            </label>

            <select class="ci-input"
                    @bind="Model.ActivoId">

                <option value="0">
                    Seleccione un instrumento
                </option>

                @foreach (var activo in Activos)
                {
                    <option value="@activo.Id">

                        @activo.Codigo -
                        @activo.Nombre

                    </option>
                }

            </select>

        </div>


        <div>

            <label>
                Laboratorio
            </label>

            <select class="ci-input"
                    @bind="Model.LaboratorioId">

                <option value="0">
                    Seleccione un laboratorio
                </option>

                @foreach (var laboratorio in Laboratorios)
                {
                    <option value="@laboratorio.Id">

                        @laboratorio.Nombre

                    </option>
                }

            </select>

        </div>


        <div>

            <label>
                Fecha de envío
            </label>

            <InputDate class="ci-input"
                       @bind-Value="Model.FechaEnvio" />

        </div>


        <div>

            <label>
                Fecha de calibración
            </label>

            <InputDate class="ci-input"
                       @bind-Value="Model.FechaCalibracion" />

        </div>


        <div>

            <label>
                Fecha de retorno
            </label>

            <InputDate class="ci-input"
                       @bind-Value="Model.FechaRetorno" />

        </div>


        <div>

            <label>
                Fecha de vencimiento
            </label>

            <InputDate class="ci-input"
                       @bind-Value="Model.FechaVencimiento" />

        </div>


        <div>

            <label>
                Número de certificado
            </label>

            <input class="ci-input"
                   @bind="Model.NumeroCertificado" />

        </div>


        <div>

            <label>
                Resultado
            </label>

            <select class="ci-input"
                    @bind="Model.Resultado">

                <option value="PENDIENTE">
                    Pendiente
                </option>

                <option value="CONFORME">
                    Conforme
                </option>

                <option value="NO_CONFORME">
                    No conforme
                </option>

            </select>

        </div>


        <div class="ci-form-full">

            <label>
                Observaciones
            </label>

            <textarea class="ci-input ci-textarea"
                      @bind="Model.Observaciones">
            </textarea>

        </div>

    </div>

</div>


@code {

    [Parameter, EditorRequired]
    public CalibracionUi Model { get; set; } =
        new();


    [Parameter]
    public List<ActivoUi> Activos { get; set; } =
        new();


    [Parameter]
    public List<LaboratorioCalibracionUi>
        Laboratorios
    { get; set; } =
            new();
}