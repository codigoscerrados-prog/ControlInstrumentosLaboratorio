@page "/recuperar-password"

@layout BlazorApp1.Components.Layout.EmptyLayout

@inject NavigationManager Navigation

<div class="ci-login-page">
    <div class="ci-login-card">

        <div class="ci-login-icon">
        </div>

        <h1>Recuperar contraseña</h1>

        <p>
            Ingresa el correo asociado a tu cuenta.
        </p>

        <label>Correo electrónico</label>

        <input class="ci-input"
               type="email"
               @bind="correo"
               placeholder="correo@ejemplo.com" />

        <button class="ci-btn ci-btn-primary ci-btn-full"
                @onclick="Recuperar">
            Enviar enlace de recuperación
        </button>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="@claseMensaje">
                @mensaje
            </div>
        }

        <div class="ci-login-links">
            <a href="/login">
                Volver al inicio de sesión
            </a>
        </div>

    </div>
</div>

@code {
    private string correo = "";

    private string mensaje = "";

    private string claseMensaje = "";

    private void Recuperar()
    {
        if (string.IsNullOrWhiteSpace(correo))
        {
            mensaje =
                "Ingresa tu correo electrónico.";

            claseMensaje =
                "ci-message-error";

            return;
        }

        // Simulación frontend
        if (correo.Equals(
            "admin@laboratorio.com",
            StringComparison.OrdinalIgnoreCase))
        {
            mensaje =
                "Se generó el enlace de recuperación.";

            claseMensaje =
                "ci-success-box";

            Navigation.NavigateTo(
                "/restablecer-password/demo-token"
            );
        }
        else
        {
            // En un sistema real es mejor no indicar
            // si el correo existe o no.
            mensaje =
                "Si el correo está registrado, recibirás un enlace de recuperación.";

            claseMensaje =
                "ci-success-box";
        }
    }
}