@page "/roles"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject SessionService Session

<div class="ci-page-header">
    <div>
        <h1>Roles</h1>
        <p>Roles definidos para el control de acceso al sistema.</p>
    </div>
</div>

@if (cargando)
{
    <div class="ci-card">
        Cargando...
    </div>
}
else
{
    <div class="ci-card">

        <div class="ci-table-wrap">

            <table class="ci-table">

                <thead>
                    <tr>
                        <th>Rol</th>
                        <th>Descripción</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var rol in roles)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @rol.Nombre
                                </strong>
                            </td>

                            <td>
                                @rol.Descripcion
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

@code {

    private bool cargando = true;

    private readonly List<RolUi> roles =
    [
        new()
        {
            Id = 1,
            Nombre = "ADMIN",
            Descripcion = "Administrador general del sistema"
        },

        new()
        {
            Id = 2,
            Nombre = "TECNICO",
            Descripcion = "Personal técnico encargado de instrumentos y calibraciones"
        },

        new()
        {
            Id = 3,
            Nombre = "CONSULTA",
            Descripcion = "Usuario con acceso únicamente a consultas"
        }
    ];

    protected override async Task OnInitializedAsync()
    {
        await Session.RestaurarSesionAsync();

        if (!Session.EsAdmin)
        {
            Navigation.NavigateTo(
                "/dashboard"
            );

            return;
        }

        cargando = false;
    }
}