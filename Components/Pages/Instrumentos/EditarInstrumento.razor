@page "/instrumentos/editar/{Id:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject ActivoService ActivoService
@inject SessionService Session
@inject GrupoInstrumentalService GrupoService
@inject TipoInstrumentoService TipoService


<div class="ci-page-header">
    <div>
        <h1>Editar instrumento</h1>
        <p>Modifica los datos del instrumento.</p>
    </div>
</div>


@if (cargando)
{
    <div class="ci-card">
        Cargando instrumento...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <InstrumentoForm Model="instrumento"
                     Grupos="grupos"
                     Tipos="tipos" />

    <div class="ci-footer-actions">

        <button class="ci-btn ci-btn-light"
                @onclick="Cancelar"
                disabled="@guardando">
            Cancelar
        </button>

        <button class="ci-btn ci-btn-primary"
                @onclick="Guardar"
                disabled="@guardando">

            @if (guardando)
            {
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar cambios</span>
            }

        </button>

    </div>
}


@code {

    [Parameter]
    public long Id { get; set; }


    private ActivoUi instrumento = new();

    private List<GrupoInstrumentalUi> grupos =
        new();

    private List<TipoInstrumentoUi> tipos =
        new();


    private bool cargando = true;

    private bool guardando;

    private string error = "";


    protected override async Task OnInitializedAsync()
    {
        await Session.RestaurarSesionAsync();

        if (!Session.PuedeEditar)
        {
            Navigation.NavigateTo(
                $"/instrumentos/ver/{Id}"
            );

            return;
        }

        await CargarDatos();
    }


    private async Task CargarDatos()
    {
        try
        {
            cargando = true;

            grupos =
                await GrupoService.ListarAsync();

            tipos =
                await TipoService.ListarAsync();

            var encontrado =
                await ActivoService.ObtenerAsync(Id);

            if (encontrado is null)
            {
                error =
                    "No se encontró el instrumento.";

                return;
            }

            instrumento = encontrado;

            instrumento.GrupoId =
                instrumento.Grupo?.Id ?? 0;

            instrumento.GrupoNombre =
                instrumento.Grupo?.Nombre ?? "";

            instrumento.TipoInstrumentoId =
                instrumento.TipoInstrumento?.Id ?? 0;

            instrumento.TipoInstrumentoNombre =
                instrumento.TipoInstrumento?.Nombre ?? "";
        }
        catch (Exception ex)
        {
            error =
                "Error al cargar el instrumento. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Guardar()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(
                instrumento.Codigo))
        {
            error =
                "Debe ingresar el código.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
                instrumento.Nombre))
        {
            error =
                "Debe ingresar el nombre.";

            return;
        }

        if (instrumento.TipoInstrumentoId <= 0)
        {
            error =
                "Debe seleccionar el tipo.";

            return;
        }

        if (instrumento.GrupoId <= 0)
        {
            error =
                "Debe seleccionar el grupo.";

            return;
        }

        try
        {
            guardando = true;

            var request =
    new ActivoRequest
    {
        Id = Id,

        Codigo = instrumento.Codigo,
        Nombre = instrumento.Nombre,
        Marca = instrumento.Marca,
        Modelo = instrumento.Modelo,
        NumeroSerie = instrumento.NumeroSerie,
        Rango = instrumento.Rango,
        Resolucion = instrumento.Resolucion,
        Ubicacion = instrumento.Ubicacion,
        Estado = instrumento.Estado,
        Observaciones = instrumento.Observaciones,

        Grupo = new ReferenciaEntidad
        {
            Id = instrumento.GrupoId
        },

        TipoInstrumento =
            new ReferenciaEntidad
            {
                Id =
                    instrumento.TipoInstrumentoId
            },

        FechaCreacion =
            instrumento.FechaCreacion,

        UsuarioCreacion =
            instrumento.UsuarioCreacion,

        FechaModificacion =
            DateTimeOffset.UtcNow,

        UsuarioModificacion =
            Session.Username
    };

            var actualizado =
                await ActivoService
                    .ActualizarAsync(
                        Id,
                        request
                    );

            if (actualizado is null)
            {
                error =
                    "No se pudieron guardar los cambios.";

                return;
            }

            Navigation.NavigateTo(
                $"/instrumentos/ver/{Id}"
            );
        }
        catch (Exception ex)
        {
            error =
                "Error al guardar los cambios. " +
                ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }


    private void Cancelar()
    {
        Navigation.NavigateTo(
            $"/instrumentos/ver/{Id}"
        );
    }
}