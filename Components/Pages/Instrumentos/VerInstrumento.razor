@page "/instrumentos/ver/{Id:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared

@inject NavigationManager Navigation

<div class="ci-page-header">
    <div>
        <h1>@instrumento.Codigo</h1>
        <p>@instrumento.Nombre</p>
    </div>

    <EstadoBadge Estado="@instrumento.Estado" />
</div>

<div class="ci-detail-grid">
    <section class="ci-card">
        <h2>Datos generales</h2>

        <dl class="ci-dl">
            <dt>Código</dt>
            <dd>@instrumento.Codigo</dd>

            <dt>Nombre</dt>
            <dd>@instrumento.Nombre</dd>

            <dt>Tipo</dt>
            <dd>@instrumento.TipoInstrumentoNombre</dd>

            <dt>Grupo</dt>
            <dd>@instrumento.GrupoNombre</dd>

            <dt>Ubicación</dt>
            <dd>@instrumento.Ubicacion</dd>
        </dl>
    </section>

    <section class="ci-card">
        <h2>Datos técnicos</h2>

        <dl class="ci-dl">
            <dt>Marca</dt>
            <dd>@instrumento.Marca</dd>

            <dt>Modelo</dt>
            <dd>@instrumento.Modelo</dd>

            <dt>Número de serie</dt>
            <dd>@instrumento.NumeroSerie</dd>

            <dt>Rango</dt>
            <dd>@instrumento.Rango</dd>

            <dt>Resolución</dt>
            <dd>@instrumento.Resolucion</dd>
        </dl>
    </section>

    <section class="ci-card ci-form-full">
        <h2>Observaciones</h2>
        <p>@instrumento.Observaciones</p>
    </section>
</div>

<div class="ci-card">
    <div class="ci-page-header">
        <div>
            <h2>Calibraciones</h2>
            <p>Historial del instrumento.</p>
        </div>

        <button class="ci-btn ci-btn-primary"
                @onclick="NuevaCalibracion">
            + Registrar calibración
        </button>
    </div>

    <table class="ci-table">
        <thead>
            <tr>
                <th>Laboratorio</th>
                <th>Fecha</th>
                <th>Vencimiento</th>
                <th>Certificado</th>
                <th>Resultado</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>METROIL</td>
                <td>15/05/2026</td>
                <td>15/05/2027</td>
                <td>CAL-026-2026</td>
                <td>CONFORME</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="ci-footer-actions">
    <button class="ci-btn ci-btn-light"
            @onclick="Volver">
        Volver
    </button>

    <button class="ci-btn ci-btn-primary"
            @onclick="Editar">
        Editar instrumento
    </button>
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private readonly ActivoUi instrumento = new()
    {
        Id = 1,
        Codigo = "MED-M-26",
        Nombre = "Manómetro digital",

        TipoInstrumentoId = 1,
        TipoInstrumentoNombre = "Manómetro",

        GrupoId = 1,
        GrupoNombre = "Banco 3",

        Marca = "UTOP",
        Modelo = "UIB6",
        NumeroSerie = "190410011",

        Rango = "0 - 20 bar",
        Resolucion = "0.001 bar",

        Ubicacion = "Entrada Banco 3",

        Estado = "OPERATIVO",

        Observaciones =
            "Manómetro instalado en la entrada del Banco 3."
    };

    private void Volver()
    {
        Navigation.NavigateTo("/instrumentos");
    }

    private void Editar()
    {
        Navigation.NavigateTo(
            $"/instrumentos/editar/{Id}"
        );
    }

    private void NuevaCalibracion()
    {
        Navigation.NavigateTo(
            $"/calibraciones/nueva/{Id}"
        );
    }
}