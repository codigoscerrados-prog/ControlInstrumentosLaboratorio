@page "/instrumentos/ver/{Id:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject ActivoService ActivoService
@inject CalibracionService CalibracionService
@inject SessionService Session

@if (cargando)
{
    <div class="ci-card">
        Cargando instrumento...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-page-header">

        <div>
            <h1>@instrumento.Codigo</h1>
            <p>@instrumento.Nombre</p>
        </div>

        <EstadoBadge Estado="@instrumento.Estado" />

    </div>


    <div class="ci-detail-grid">

        <section class="ci-card">

            <h2>Datos generales</h2>

            <dl class="ci-dl">

                <dt>Código</dt>
                <dd>@instrumento.Codigo</dd>

                <dt>Nombre</dt>
                <dd>@instrumento.Nombre</dd>

                <dt>Tipo</dt>
                <dd>
                    @(instrumento.TipoInstrumento?.Nombre
                        ?? "-")
                </dd>

                <dt>Grupo</dt>
                <dd>
                    @(instrumento.Grupo?.Nombre
                        ?? "-")
                </dd>

                <dt>Ubicación</dt>
                <dd>@instrumento.Ubicacion</dd>

            </dl>

        </section>


        <section class="ci-card">

            <h2>Datos técnicos</h2>

            <dl class="ci-dl">

                <dt>Marca</dt>
                <dd>@instrumento.Marca</dd>

                <dt>Modelo</dt>
                <dd>@instrumento.Modelo</dd>

                <dt>Número de serie</dt>
                <dd>@instrumento.NumeroSerie</dd>

                <dt>Rango</dt>
                <dd>@instrumento.Rango</dd>

                <dt>Resolución</dt>
                <dd>@instrumento.Resolucion</dd>

            </dl>

        </section>


        <section class="ci-card ci-form-full">

            <h2>Observaciones</h2>

            <p>
                @(string.IsNullOrWhiteSpace(
                    instrumento.Observaciones)
                    ? "Sin observaciones."
                    : instrumento.Observaciones)
            </p>

        </section>

    </div>


    <div class="ci-card">

        <div class="ci-page-header">

            <div>
                <h2>Calibraciones</h2>

                <p>
                    Historial del instrumento.
                </p>
            </div>

            @if (Session.PuedeEditar)
            {
                <button class="ci-btn ci-btn-primary"
                        @onclick="NuevaCalibracion">
                    + Registrar calibración
                </button>
            }

        </div>

        @if (!calibraciones.Any())
        {
            <p class="text-muted">
                Este instrumento todavía no tiene
                calibraciones registradas.
            </p>
        }
        else
        {
            <div class="ci-table-wrap">

                <table class="ci-table">

                    <thead>
                        <tr>
                            <th>Laboratorio</th>
                            <th>Fecha calibración</th>
                            <th>Vencimiento</th>
                            <th>Certificado</th>
                            <th>Resultado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var calibracion in calibraciones)
                        {
                            <tr>

                                <td>
                                    @ObtenerLaboratorio(calibracion)
                                </td>

                                <td>
                                    @Fecha(
                                        calibracion.FechaCalibracion
                                    )
                                </td>

                                <td>
                                    @Fecha(
                                        calibracion.FechaVencimiento
                                    )
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        calibracion.NumeroCertificado)
                                        ? "-"
                                        : calibracion.NumeroCertificado)
                                </td>

                                <td>
                                    @calibracion.Resultado
                                </td>

                                <td>
                                    @if (Session.PuedeEditar)
                                    {
                                        <button class="ci-btn ci-btn-light"
                                                @onclick="() => EditarCalibracion(calibracion.Id)">
                                            Editar
                                        </button>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <div class="ci-footer-actions">

        <button class="ci-btn ci-btn-light"
                @onclick="Volver">

            Volver

        </button>

        @if (Session.PuedeEditar)
        {
            <button class="ci-btn ci-btn-primary"
                    @onclick="Editar">
                Editar instrumento
            </button>
        }

    </div>
}


@code {

    [Parameter]
    public long Id { get; set; }


    private ActivoUi instrumento =
        new();

    private List<CalibracionUi> calibraciones =
    new();

    private bool cargando = true;

    private string error = "";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;

            var encontrado =
                await ActivoService
                    .ObtenerAsync(Id);

            if (encontrado is null)
            {
                error =
                    "No se encontró el instrumento.";

                return;
            }

            instrumento = encontrado;

            calibraciones =
                await CalibracionService
                    .ListarPorActivoAsync(Id);
        }
        catch (Exception ex)
        {
            error =
                "No se pudo cargar el instrumento. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string ObtenerLaboratorio(
    CalibracionUi calibracion)
    {
        return calibracion.Laboratorio?.Nombre
               ?? calibracion
                   .LaboratorioCalibracion?.Nombre
               ?? "-";
    }

    private static string Fecha(
    DateTime? fecha)
    {
        return fecha?.ToString(
            "dd/MM/yyyy"
        ) ?? "-";
    }

    private void EditarCalibracion(
    long id)
    {
        Navigation.NavigateTo(
            $"/calibraciones/editar/{id}"
        );
    }

    private void Volver()
    {
        Navigation.NavigateTo(
            "/instrumentos"
        );
    }


    private void Editar()
    {
        Navigation.NavigateTo(
            $"/instrumentos/editar/{Id}"
        );
    }


    private void NuevaCalibracion()
    {
        Navigation.NavigateTo(
            $"/calibraciones/nueva/{Id}"
        );
    }
}