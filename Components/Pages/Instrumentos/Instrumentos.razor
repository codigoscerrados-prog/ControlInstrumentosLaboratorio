@page "/instrumentos"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services

@inject SessionService Session
@inject NavigationManager Navigation
@inject ActivoService ActivoService


<div class="ci-page-header">

    <div>
        <h1>Instrumentos de Laboratorio</h1>

        <p>
            Consulta, crea, edita y cambia el estado.
        </p>
    </div>

    @if (Session.PuedeEditar)
    {
        <button class="ci-btn ci-btn-primary"
                @onclick="Nuevo">
            + Nuevo instrumento
        </button>
    }

</div>


<div class="ci-card ci-filter-card">

    <input class="ci-input"
           @bind="busqueda"
           @bind:event="oninput"
           placeholder="Buscar..." />

    <select class="ci-input"
            @bind="estadoFiltro">

        <option value="">
            Todos los estados
        </option>

        <option value="OPERATIVO">
            OPERATIVO
        </option>

        <option value="EN_CALIBRACION">
            EN CALIBRACIÓN
        </option>

        <option value="EN_MANTENIMIENTO">
            EN MANTENIMIENTO
        </option>

        <option value="FUERA_SERVICIO">
            FUERA DE SERVICIO
        </option>

        <option value="BAJA">
            BAJA
        </option>

    </select>

</div>


@if (cargando)
{
    <div class="ci-card">

        Cargando instrumentos...

    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">

        @error

    </div>
}
else
{
    <div class="ci-card">

        <div class="ci-table-wrap">

            <table class="ci-table">

                <thead>

                    <tr>
                        <th>Código</th>
                        <th>Instrumento</th>
                        <th>Tipo</th>
                        <th>Grupo</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Filtrados.Any())
                    {
                        <tr>
                            <td colspan="8">
                                No se encontraron instrumentos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var instrumento in Filtrados)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @instrumento.Codigo
                                    </strong>
                                </td>

                                <td>
                                    @instrumento.Nombre
                                </td>

                                <td>
                                    @(instrumento.TipoInstrumento?.Nombre
                                        ?? "-")
                                </td>

                                <td>
                                    @(instrumento.Grupo?.Nombre
                                        ?? "-")
                                </td>

                                <td>
                                    @instrumento.Marca
                                </td>

                                <td>
                                    @instrumento.Modelo
                                </td>

                                <td>

                                    <EstadoBadge Estado="@instrumento.Estado" />

                                </td>

                                <td class="ci-actions">

                                    <button class="ci-btn ci-btn-light"
                                            @onclick="() => Ver(instrumento.Id)">

                                        Ver

                                    </button>

                                    <button class="ci-btn ci-btn-light"
                                            @onclick="() => Editar(instrumento.Id)">

                                        Editar

                                    </button>

                                    @if (Session.PuedeEditar)
                                    {
                                        <button class="ci-btn ci-btn-light"
                                                @onclick="() => Editar(instrumento.Id)">
                                            Editar
                                        </button>

                                        @if (instrumento.Estado != "BAJA")
                                        {
                                            <button class="ci-btn ci-btn-danger-soft"
                                                    @onclick="() => DarDeBaja(instrumento)">
                                                Dar de baja
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="ci-btn ci-btn-success-soft"
                                                    @onclick="() => Reactivar(instrumento)">
                                                Reactivar
                                            </button>
                                        }
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@code {

    private string busqueda = "";

    private string estadoFiltro = "";

    private bool cargando = true;

    private string error = "";

    private List<ActivoUi> instrumentos = new();

    private long? procesandoId;

    protected override async Task OnInitializedAsync()
    {
        await CargarInstrumentos();
    }


    private async Task CargarInstrumentos()
    {
        try
        {
            cargando = true;

            error = "";

            instrumentos =
                await ActivoService.ListarAsync();
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron cargar los instrumentos. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private IEnumerable<ActivoUi> Filtrados =>
        instrumentos.Where(
            x =>
                (
                    string.IsNullOrWhiteSpace(busqueda)
                    ||
                    x.Codigo.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    x.Nombre.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    x.Marca.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                &&
                (
                    string.IsNullOrWhiteSpace(
                        estadoFiltro
                    )
                    ||
                    x.Estado == estadoFiltro
                )
        );


    private void Nuevo()
    {
        Navigation.NavigateTo(
            "/instrumentos/nuevo"
        );
    }


    private void Ver(long id)
    {
        Navigation.NavigateTo(
            $"/instrumentos/ver/{id}"
        );
    }


    private void Editar(long id)
    {
        Navigation.NavigateTo(
            $"/instrumentos/editar/{id}"
        );
    }

    private async Task DarDeBaja(
    ActivoUi instrumento)
    {
        await CambiarEstado(
            instrumento,
            "BAJA"
        );
    }


    private async Task Reactivar(
        ActivoUi instrumento)
    {
        await CambiarEstado(
            instrumento,
            "OPERATIVO"
        );
    }


    private async Task CambiarEstado(
        ActivoUi instrumento,
        string estado)
    {
        try
        {
            procesandoId =
                instrumento.Id;

            error = "";

            var actualizado =
                await ActivoService
                    .CambiarEstadoAsync(
                        instrumento,
                        estado
                    );

            if (actualizado is null)
            {
                error =
                    "No se pudo cambiar el estado.";

                return;
            }

            await CargarInstrumentos();
        }
        catch (Exception ex)
        {
            error =
                "Error al cambiar el estado. " +
                ex.Message;
        }
        finally
        {
            procesandoId = null;
        }
    }
}