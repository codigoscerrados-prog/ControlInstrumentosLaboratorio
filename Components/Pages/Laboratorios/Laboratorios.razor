@page "/laboratorios"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject LaboratorioCalibracionService LaboratorioService
@inject SessionService Session

<div class="ci-page-header">
    <div>
        <h1>Laboratorios de Calibración</h1>
        <p>Administra los laboratorios externos.</p>
    </div>

    @if (Session.PuedeEditar)
    {
        <button class="ci-btn ci-btn-primary"
                @onclick="Nuevo">
            + Nuevo laboratorio
        </button>
    }
</div>


@if (cargando)
{
    <div class="ci-card">
        Cargando laboratorios...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-card">

        <div class="ci-table-wrap">

            <table class="ci-table">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>RUC</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!laboratorios.Any())
                    {
                        <tr>
                            <td colspan="6">
                                No existen laboratorios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var laboratorio in laboratorios)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @laboratorio.Nombre
                                    </strong>
                                </td>

                                <td>@laboratorio.Ruc</td>

                                <td>@laboratorio.Telefono</td>

                                <td>@laboratorio.Correo</td>

                                <td>
                                    <EstadoBadge Estado="@laboratorio.Estado" />
                                </td>

                                <td class="ci-actions">

                                    <button class="ci-btn ci-btn-light"
                                            @onclick="() => Ver(laboratorio.Id)">
                                        Ver
                                    </button>

                                    @if (Session.PuedeEditar)
                                    {
                                        <button class="ci-btn ci-btn-light"
                                                @onclick="() => Editar(laboratorio.Id)">
                                            Editar
                                        </button>
                                    }

                                </td>



                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@code {

    private List<LaboratorioCalibracionUi>
        laboratorios = new();

    private bool cargando = true;

    private string error = "";

    private void Ver(long id)
    {
        Navigation.NavigateTo(
            $"/laboratorios/ver/{id}"
        );
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarLaboratorios();
    }


    private async Task CargarLaboratorios()
    {
        try
        {
            cargando = true;

            error = "";

            laboratorios =
                await LaboratorioService.ListarAsync();
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron cargar los laboratorios. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private void Nuevo()
    {
        Navigation.NavigateTo(
            "/laboratorios/nuevo"
        );
    }


    private void Editar(long id)
    {
        Navigation.NavigateTo(
            $"/laboratorios/editar/{id}"
        );
    }
}