@page "/grupos"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject GrupoInstrumentalService GrupoService


<div class="ci-page-header">
    <div>
        <h1>Grupos instrumentales</h1>
        <p>Bancos, patrones y respaldo.</p>
    </div>

    <button class="ci-btn ci-btn-primary"
            @onclick="Nuevo">
        + Nuevo grupo
    </button>
</div>


@if (cargando)
{
    <div class="ci-card">
        Cargando grupos...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-card">

        <div class="ci-table-wrap">

            <table class="ci-table">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!grupos.Any())
                    {
                        <tr>
                            <td colspan="4">
                                No existen grupos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var grupo in grupos)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @grupo.Codigo
                                    </strong>
                                </td>

                                <td>@grupo.Nombre</td>

                                <td>@grupo.Descripcion</td>

                                <td>
                                    <button class="ci-btn ci-btn-light"
                                            @onclick="() => Editar(grupo.Id)">
                                        Editar
                                    </button>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@code {

    private List<GrupoInstrumentalUi> grupos =
        new();

    private bool cargando = true;

    private string error = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarGrupos();
    }


    private async Task CargarGrupos()
    {
        try
        {
            cargando = true;

            error = "";

            grupos =
                await GrupoService.ListarAsync();
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron cargar los grupos. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private void Nuevo()
    {
        Navigation.NavigateTo(
            "/grupos/nuevo"
        );
    }


    private void Editar(long id)
    {
        Navigation.NavigateTo(
            $"/grupos/editar/{id}"
        );
    }
}