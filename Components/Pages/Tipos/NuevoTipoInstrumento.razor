@page "/tipos-instrumento/nuevo"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject TipoInstrumentoService TipoService
@inject SessionService Session


<div class="ci-page-header">
    <div>
        <h1>Nuevo tipo de instrumento</h1>
        <p>Registra un nuevo tipo.</p>
    </div>
</div>


<div class="ci-card ci-form-grid">

    <div>
        <label>Nombre</label>

        <input class="ci-input"
               @bind="tipo.Nombre" />
    </div>

    <div class="ci-form-full">

        <label>Descripción</label>

        <textarea class="ci-input ci-textarea"
                  @bind="tipo.Descripcion">
        </textarea>

    </div>

</div>


<div class="ci-footer-actions">

    <button class="ci-btn ci-btn-light"
            @onclick="Cancelar"
            disabled="@guardando">

        Cancelar

    </button>

    <button class="ci-btn ci-btn-primary"
            @onclick="Guardar"
            disabled="@guardando">

        @if (guardando)
        {
            <span>Guardando...</span>
        }
        else
        {
            <span>Guardar</span>
        }

    </button>

</div>


@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}


@code {

    private TipoInstrumentoUi tipo =
        new();

    private bool guardando;

    private string error = "";


    private async Task Guardar()
    {
        error = "";


        if (string.IsNullOrWhiteSpace(
                tipo.Nombre))
        {
            error =
                "Debe ingresar el nombre.";

            return;
        }


        try
        {
            guardando = true;


            var request =
                new TipoInstrumentoRequest
                {
                    Nombre =
                        tipo.Nombre,

                    Descripcion =
                        tipo.Descripcion,

                    FechaCreacion =
                        DateTimeOffset.UtcNow,

                    UsuarioCreacion =
                        Session.Username,

                    FechaModificacion =
                        null,

                    UsuarioModificacion =
                        null
                };


            var creado =
                await TipoService
                    .CrearAsync(request);


            if (creado is null)
            {
                error =
                    "No se pudo registrar el tipo.";

                return;
            }


            Navigation.NavigateTo(
                "/tipos-instrumento"
            );
        }
        catch (Exception ex)
        {
            error =
                "Error al guardar el tipo. " +
                ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }


    private void Cancelar()
    {
        Navigation.NavigateTo(
            "/tipos-instrumento"
        );
    }
}