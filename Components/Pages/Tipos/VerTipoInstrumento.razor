@page "/tipos-instrumento/ver/{Id:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject TipoInstrumentoService TipoService
@inject SessionService Session

@if (cargando)
{
    <div class="ci-card">
        Cargando tipo...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-page-header">
        <div>
            <h1>@tipo.Nombre</h1>
            <p>Detalle del tipo de instrumento.</p>
        </div>
    </div>

    <div class="ci-card">

        <dl class="ci-dl">

            <dt>Nombre</dt>
            <dd>@tipo.Nombre</dd>

            <dt>Descripción</dt>
            <dd>
                @(string.IsNullOrWhiteSpace(tipo.Descripcion)
                    ? "-"
                    : tipo.Descripcion)
            </dd>

        </dl>

    </div>

    <div class="ci-footer-actions">

        <button class="ci-btn ci-btn-light"
                @onclick="Volver">
            Volver
        </button>

        @if (Session.PuedeEditar)
        {
            <button class="ci-btn ci-btn-primary"
                    @onclick="Editar">
                Editar
            </button>
        }

    </div>
}

@code {
    [Parameter]
    public long Id { get; set; }

    private TipoInstrumentoUi tipo = new();

    private bool cargando = true;

    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await Session.RestaurarSesionAsync();

        try
        {
            var encontrado =
                await TipoService.ObtenerAsync(Id);

            if (encontrado is null)
            {
                error = "No se encontró el tipo.";
                return;
            }

            tipo = encontrado;
        }
        catch (Exception ex)
        {
            error =
                "No se pudo cargar el tipo. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo(
            "/tipos-instrumento"
        );
    }

    private void Editar()
    {
        Navigation.NavigateTo(
            $"/tipos-instrumento/editar/{Id}"
        );
    }
}