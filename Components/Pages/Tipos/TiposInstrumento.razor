@page "/tipos-instrumento"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject TipoInstrumentoService TipoService
@inject SessionService Session

<div class="ci-page-header">
    <div>
        <h1>Tipos de instrumento</h1>
        <p>Catálogo de tipos.</p>
    </div>
    @if (Session.PuedeEditar)
{
    <button class="ci-btn ci-btn-primary"
            @onclick="Nuevo">
        + Nuevo tipo
        </button>
    }
</div>


@if (cargando)
{
    <div class="ci-card">
        Cargando tipos de instrumento...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-card">

        <div class="ci-table-wrap">

            <table class="ci-table">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!tipos.Any())
                    {
                        <tr>
                            <td colspan="3">
                                No existen tipos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tipo in tipos)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @tipo.Nombre
                                    </strong>
                                </td>

                                <td>
                                    @tipo.Descripcion
                                </td>

                                <td class="ci-actions">

                                    <button class="ci-btn ci-btn-light"
                                            @onclick="() => Ver(tipo.Id)">
                                        Ver
                                    </button>

                                    @if (Session.PuedeEditar)
                                    {
                                        <button class="ci-btn ci-btn-light"
                                                @onclick="() => Editar(tipo.Id)">
                                            Editar
                                        </button>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@code {

    private List<TipoInstrumentoUi> tipos =
        new();

    private bool cargando = true;

    private string error = "";

    private void Ver(long id)
    {
        Navigation.NavigateTo(
            $"/tipos-instrumento/ver/{id}"
        );
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarTipos();
    }


    private async Task CargarTipos()
    {
        try
        {
            cargando = true;

            error = "";

            tipos =
                await TipoService.ListarAsync();
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron cargar los tipos. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private void Nuevo()
    {
        Navigation.NavigateTo(
            "/tipos-instrumento/nuevo"
        );
    }


    private void Editar(long id)
    {
        Navigation.NavigateTo(
            $"/tipos-instrumento/editar/{id}"
        );
    }
}