@page "/restablecer-password/{Token}"

@layout BlazorApp1.Components.Layout.EmptyLayout

@inject NavigationManager Navigation

<div class="ci-login-page">
    <div class="ci-login-card">

        <div class="ci-login-icon">
            ⚗
        </div>

        <h1>Nueva contraseña</h1>

        <p>
            Ingresa y confirma tu nueva contraseña.
        </p>

        <label>Nueva contraseña</label>

        <input class="ci-input"
               type="password"
               @bind="password" />

        <label>Confirmar contraseña</label>

        <input class="ci-input"
               type="password"
               @bind="confirmacion" />

        <button class="ci-btn ci-btn-primary ci-btn-full"
                @onclick="CambiarPassword">
            Cambiar contraseña
        </button>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="@claseMensaje">
                @mensaje
            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    private string password = "";

    private string confirmacion = "";

    private string mensaje = "";

    private string claseMensaje = "";

    private void CambiarPassword()
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            mensaje =
                "Ingresa una nueva contraseña.";

            claseMensaje =
                "ci-message-error";

            return;
        }

        if (password != confirmacion)
        {
            mensaje =
                "Las contraseñas no coinciden.";

            claseMensaje =
                "ci-message-error";

            return;
        }

        mensaje =
            "Contraseña actualizada correctamente.";

        claseMensaje =
            "ci-success-box";
    }
}