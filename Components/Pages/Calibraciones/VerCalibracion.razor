@page "/calibraciones/ver/{Id:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Services

@inject NavigationManager Navigation
@inject CalibracionService CalibracionService
@inject SessionService Session

@if (cargando)
{
    <div class="ci-card">
        Cargando calibración...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">
        @error
    </div>
}
else
{
    <div class="ci-page-header">
        <div>
            <h1>Detalle de calibración</h1>

            <p>
                @(calibracion.Activo?.Codigo ?? "Instrumento")
            </p>
        </div>
    </div>

    <div class="ci-detail-grid">

        <section class="ci-card">

            <h2>Instrumento</h2>

            <dl class="ci-dl">

                <dt>Código</dt>
                <dd>
                    @(calibracion.Activo?.Codigo ?? "-")
                </dd>

                <dt>Nombre</dt>
                <dd>
                    @(calibracion.Activo?.Nombre ?? "-")
                </dd>

                <dt>Laboratorio</dt>
                <dd>
                    @ObtenerLaboratorio()
                </dd>

            </dl>

        </section>

        <section class="ci-card">

            <h2>Calibración</h2>

            <dl class="ci-dl">

                <dt>Fecha envío</dt>
                <dd>
                    @Fecha(calibracion.FechaEnvio)
                </dd>

                <dt>Fecha calibración</dt>
                <dd>
                    @Fecha(calibracion.FechaCalibracion)
                </dd>

                <dt>Fecha retorno</dt>
                <dd>
                    @Fecha(calibracion.FechaRetorno)
                </dd>

                <dt>Vencimiento</dt>
                <dd>
                    @Fecha(calibracion.FechaVencimiento)
                </dd>

                <dt>Certificado</dt>
                <dd>
                    @(string.IsNullOrWhiteSpace(
                        calibracion.NumeroCertificado)
                        ? "-"
                        : calibracion.NumeroCertificado)
                </dd>

                <dt>Resultado</dt>
                <dd>
                    @calibracion.Resultado
                </dd>

            </dl>

        </section>

        <section class="ci-card ci-form-full">

            <h2>Observaciones</h2>

            <p>
                @(string.IsNullOrWhiteSpace(
                    calibracion.Observaciones)
                    ? "Sin observaciones."
                    : calibracion.Observaciones)
            </p>

        </section>

    </div>

    <div class="ci-footer-actions">

        <button class="ci-btn ci-btn-light"
                @onclick="Volver">
            Volver
        </button>

        @if (Session.PuedeEditar)
        {
            <button class="ci-btn ci-btn-primary"
                    @onclick="Editar">
                Editar
            </button>
        }

    </div>
}

@code {

    [Parameter]
    public long Id { get; set; }

    private CalibracionUi calibracion = new();

    private bool cargando = true;

    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await Session.RestaurarSesionAsync();

        try
        {
            cargando = true;

            var encontrada =
                await CalibracionService
                    .ObtenerAsync(Id);

            if (encontrada is null)
            {
                error =
                    "No se encontró la calibración.";

                return;
            }

            calibracion = encontrada;
        }
        catch (Exception ex)
        {
            error =
                "No se pudo cargar la calibración. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerLaboratorio()
    {
        return calibracion.Laboratorio?.Nombre
            ?? calibracion
                .LaboratorioCalibracion?.Nombre
            ?? "-";
    }

    private static string Fecha(
        DateTime? fecha)
    {
        return fecha?.ToString(
            "dd/MM/yyyy"
        ) ?? "-";
    }

    private void Volver()
    {
        Navigation.NavigateTo(
            "/calibraciones"
        );
    }

    private void Editar()
    {
        Navigation.NavigateTo(
            $"/calibraciones/editar/{Id}"
        );
    }
}