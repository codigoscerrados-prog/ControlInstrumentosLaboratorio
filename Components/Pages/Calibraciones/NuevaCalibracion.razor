@page "/calibraciones/nueva"
@page "/calibraciones/nueva/{ActivoId:long}"

@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services

@inject NavigationManager Navigation

@inject CalibracionService CalibracionService
@inject ActivoService ActivoService
@inject LaboratorioCalibracionService LaboratorioService
@inject SessionService Session


<div class="ci-page-header">

    <div>

        <h1>
            Nueva calibración
        </h1>

        <p>
            Registra el envío y resultado
            de calibración.
        </p>

    </div>

</div>


@if (cargando)
{
    <div class="ci-card">
        Cargando formulario...
    </div>
}
else
{
    <CalibracionForm Model="calibracion"
                     Activos="activos"
                     Laboratorios="laboratorios" />


    <div class="ci-footer-actions">

        <button class="ci-btn ci-btn-light"
                @onclick="Cancelar"
                disabled="@guardando">

            Cancelar

        </button>


        <button class="ci-btn ci-btn-primary"
                @onclick="Guardar"
                disabled="@guardando">

            @if (guardando)
            {
                <span>
                    Guardando...
                </span>
            }
            else
            {
                <span>
                    Guardar calibración
                </span>
            }

        </button>

    </div>
}


@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ci-message-error">

        @error

    </div>
}


@code {

    [Parameter]
    public long? ActivoId { get; set; }


    private CalibracionUi calibracion =
        new()
        {
            Resultado = "PENDIENTE"
        };


    private List<ActivoUi> activos =
        new();


    private List<LaboratorioCalibracionUi>
        laboratorios =
            new();


    private bool cargando = true;

    private bool guardando;

    private string error = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
    }


    private async Task CargarCatalogos()
    {
        try
        {
            cargando = true;

            activos =
                await ActivoService.ListarAsync();

            laboratorios =
                await LaboratorioService
                    .ListarAsync();


            if (ActivoId.HasValue)
            {
                calibracion.ActivoId =
                    ActivoId.Value;
            }
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron cargar los datos. " +
                ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Guardar()
    {
        error = "";


        if (calibracion.ActivoId <= 0)
        {
            error =
                "Debe seleccionar un instrumento.";

            return;
        }


        if (calibracion.LaboratorioId <= 0)
        {
            error =
                "Debe seleccionar un laboratorio.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
                calibracion.Resultado))
        {
            error =
                "Debe seleccionar un resultado.";

            return;
        }


        try
        {
            guardando = true;


            var request =
                new CalibracionRequest
                {
                    FechaEnvio =
                        calibracion.FechaEnvio,

                    FechaCalibracion =
                        calibracion.FechaCalibracion,

                    FechaRetorno =
                        calibracion.FechaRetorno,

                    FechaVencimiento =
                        calibracion.FechaVencimiento,

                    NumeroCertificado =
                        calibracion.NumeroCertificado,

                    Resultado =
                        calibracion.Resultado,

                    Observaciones =
                        calibracion.Observaciones,


                    Activo =
                        new ReferenciaEntidad
                        {
                            Id =
                                calibracion.ActivoId
                        },


                    Laboratorio =
                        new ReferenciaEntidad
                        {
                            Id =
                                calibracion.LaboratorioId
                        },


                    FechaCreacion =
                        DateTimeOffset.UtcNow,

                    UsuarioCreacion =
                        Session.Username,

                    FechaModificacion =
                        null,

                    UsuarioModificacion =
                        null
                };


            var creada =
                await CalibracionService
                    .CrearAsync(request);


            if (creada is null)
            {
                error =
                    "No se pudo registrar la calibración.";

                return;
            }


            if (ActivoId.HasValue)
            {
                Navigation.NavigateTo(
                    $"/instrumentos/ver/{ActivoId.Value}"
                );
            }
            else
            {
                Navigation.NavigateTo(
                    "/calibraciones"
                );
            }
        }
        catch (Exception ex)
        {
            error =
                "Error al guardar la calibración. " +
                ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }


    private void Cancelar()
    {
        if (ActivoId.HasValue)
        {
            Navigation.NavigateTo(
                $"/instrumentos/ver/{ActivoId.Value}"
            );
        }
        else
        {
            Navigation.NavigateTo(
                "/calibraciones"
            );
        }
    }
}