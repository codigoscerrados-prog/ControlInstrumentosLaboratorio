@page "/"
@page "/login"

@layout BlazorApp1.Components.Layout.EmptyLayout

@inject NavigationManager Navigation
@inject BlazorApp1.Services.AuthService AuthService

<div class="ci-login-page">

    <div class="ci-login-card">

        <div class="ci-login-icon">⚗</div>

        <h1>Control de Instrumentos</h1>

        <p>Gestión de instrumentos de laboratorio</p>


        <label>Usuario</label>

        <input class="ci-input"
               @bind="usuario"
               autocomplete="username"
               placeholder="Ingrese su usuario" />


        <label>Contraseña</label>

        <input class="ci-input"
               type="password"
               @bind="password"
               autocomplete="current-password"
               placeholder="Ingrese su contraseña" />


        <label class="ci-check">

            <input type="checkbox"
                   @bind="recordarme" />

            Recordarme

        </label>

        <div class="ci-login-links">
            <a href="/recuperar-password">
                ¿Olvidaste tu contraseña?
            </a>
        </div>

        <button class="ci-btn ci-btn-primary ci-btn-full"
                @onclick="Ingresar"
                disabled="@procesando">

            @if (procesando)
            {
                <span>Ingresando...</span>
            }
            else
            {
                <span>Iniciar sesión</span>
            }

        </button>


        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="ci-message-error">

                @mensaje

            </div>
        }

    </div>

</div>


@code {

    private string usuario = "";

    private string password = "";

    private bool recordarme;

    private string mensaje = "";


    private bool procesando;

    private async Task Ingresar()
    {
        mensaje = "";

        if (string.IsNullOrWhiteSpace(usuario) ||
            string.IsNullOrWhiteSpace(password))
        {
            mensaje =
                "Ingrese usuario y contraseña.";

            return;
        }

        try
        {
            procesando = true;

            var correcto =
                await AuthService.LoginAsync(
                    usuario,
                    password,
                    recordarme
                );

            if (correcto)
            {
                Navigation.NavigateTo(
                    "/dashboard"
                );
            }
            else
            {
                mensaje =
                    "Usuario o contraseña incorrectos.";
            }
        }
        catch
        {
            mensaje =
                "No se pudo conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

}