@page "/"
@page "/login"

@layout BlazorApp1.Components.Layout.EmptyLayout

@inject NavigationManager Navigation
@inject BlazorApp1.Services.AuthService AuthService

<div class="ci-login-page">

    <div class="ci-login-card">

        <div class="ci-login-icon">⚗</div>

        <h1>Control de Instrumentos</h1>

        <p>Gestión de instrumentos de laboratorio</p>

        <form @onsubmit="Ingresar"
              @onsubmit:preventDefault="true"
              autocomplete="on">

            <label for="username">
                Usuario
            </label>

            <input id="username"
                   name="username"
                   class="ci-input"
                   type="text"
                   @bind="usuario"
                   autocomplete="username"
                   placeholder="Ingrese su usuario" />


            <label for="password">
                Contraseña
            </label>

            <input id="password"
                   name="password"
                   class="ci-input"
                   type="password"
                   @bind="password"
                   autocomplete="current-password"
                   placeholder="Ingrese su contraseña" />





            <div class="ci-login-links">

                <a href="/recuperar-password">
                    ¿Olvidaste tu contraseña?
                </a>

            </div>


            <button type="submit"
                    class="ci-btn ci-btn-primary ci-btn-full"
                    disabled="@procesando">

                @if (procesando)
                {
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Iniciar sesión</span>
                }

            </button>

        </form>


        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="ci-message-error">
                @mensaje
            </div>
        }

    </div>

</div>


@code {

    private string usuario = "";

    private string password = "";


    private string mensaje = "";


    private bool procesando;

    private async Task Ingresar()
    {
        mensaje = "";

        if (string.IsNullOrWhiteSpace(usuario) ||
            string.IsNullOrWhiteSpace(password))
        {
            mensaje =
                "Ingrese usuario y contraseña.";

            return;
        }

        try
        {
            procesando = true;

            var correcto =
                await AuthService.LoginAsync(
                    usuario,
                    password
                );

            if (correcto)
            {
                Navigation.NavigateTo(
                    "/dashboard"
                );
            }
            else
            {
                mensaje =
                    "Usuario o contraseña incorrectos.";
            }
        }
        catch
        {
            mensaje =
                "No se pudo conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    protected override void OnInitialized()
    {
        var uri =
            Navigation.ToAbsoluteUri(
                Navigation.Uri
            );

        if (Microsoft.AspNetCore.WebUtilities
            .QueryHelpers
            .ParseQuery(uri.Query)
            .TryGetValue(
                "motivo",
                out var motivo) &&
            motivo == "inactividad")
        {
            mensaje =
                "La sesión se cerró por 10 minutos de inactividad.";
        }
    }

}